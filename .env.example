# =============================================================================
# .env.example
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` a Git.
# Este archivo SÍ se versiona: solo placeholders, nunca secretos.
#
# Las variables con prefijo NEXT_PUBLIC_ son las ÚNICAS que Next.js inlinea en
# el bundle del navegador, y su valor queda congelado en tiempo de build:
# cambiarlas exige volver a construir (`pnpm build`). Solo se usa ese prefijo
# para valores públicos por diseño (URL de la app, cloud name, upload preset).
# El resto se lee únicamente en el servidor y NUNCA debe llevar el prefijo.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Entorno de ejecución. Valores típicos: development | staging | production
ENVIRONMENT="development"

# URL pública base de la app (links en emails, redirects, SEO, cliente de auth).
# Local: http://localhost:3000 | Producción: https://tu-dominio.com
# Va con prefijo NEXT_PUBLIC_ porque `auth-client.ts` y `not-found.tsx` la
# leen en el navegador; también la usan las server actions y los emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nivel de logs. Valores: debug | info | warn | error
LOG_LEVEL="error"

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL en Neon)
# -----------------------------------------------------------------------------
# Cadena de conexión. Usa la URL "pooled" de Neon para la app.
# Formato: postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# -----------------------------------------------------------------------------
# Autenticación (Better Auth)
# -----------------------------------------------------------------------------
# Secreto para firmar sesiones/tokens. Mínimo 32 caracteres aleatorios.
# Genéralo con: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# URL base donde corre la app (debe coincidir con el dominio real en cada entorno)
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Roles / RBAC
# -----------------------------------------------------------------------------
# Nombre del rol con permisos totales. Debe existir en tu esquema de roles.
SUPER_ADMIN_ROLE="admin"

# -----------------------------------------------------------------------------
# Seeds
# -----------------------------------------------------------------------------
# Contraseña asignada a los usuarios creados por el script de seed.
# Solo para desarrollo. Nunca reutilices la de producción.
SEED_USERS_PASSWORD="change-me"

# -----------------------------------------------------------------------------
# Almacenamiento de imágenes (Cloudinary)
# -----------------------------------------------------------------------------
# Cloud name de tu cuenta. Público por diseño: aparece en la URL de entrega de
# cada imagen y lo necesita el navegador para construir la URL de subida.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Upload preset de subida directa desde el navegador. DEBE ser un preset
# "unsigned": no concede credenciales y es público por diseño. También lo lee
# el módulo de borrado, así que un solo nombre sirve para ambos lados.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# Credenciales privadas. Nunca con prefijo NEXT_PUBLIC_: solo las usa la server
# action que firma el borrado de imágenes.
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# Emails (Mailtrap)
# -----------------------------------------------------------------------------
# Token de API de Mailtrap
MAILTRAP_API_TOKEN="your-mailtrap-api-token"

# Remitente de los correos. El dominio debe estar verificado en producción.
MAILTRAP_FROM_EMAIL="no-reply@your-domain.com"

# Nombre visible del remitente (opcional; vacío = correo sin nombre)
MAILTRAP_FROM_NAME="Your App Name"

# ID del inbox de pruebas (solo desarrollo/staging)
MAILTRAP_TEST_INBOX_ID="your-test-inbox-id"